diff --git a/godot-storekit2/GodotStoreKit2Swift.swift b/godot-storekit2/GodotStoreKit2Swift.swift
--- a/godot-storekit2/GodotStoreKit2Swift.swift
+++ b/godot-storekit2/GodotStoreKit2Swift.swift
@@ -151,3 +151,30 @@
-	public func restorePurchases() async throws -> Void {
-		try await AppStore.sync()
+	private func restoreErrorCode(error: Error) -> NSString {
+		if let storeKitError = error as? StoreKitError {
+			switch storeKitError {
+			case .userCancelled:
+				return "cancelled"
+			case .networkError(_):
+				return "network_error"
+			case .systemError(let underlyingError):
+				return restoreErrorCode(error: underlyingError)
+			default:
+				return "failed"
+			}
+		}
+		if let urlError = error as? URLError {
+			if urlError.code == .userCancelledAuthentication {
+				return "cancelled"
+			}
+			return "network_error"
+		}
+		return "failed"
+	}
+
+	public func restorePurchases() async -> NSString {
+		do {
+			try await AppStore.sync()
+			return ""
+		} catch {
+			return restoreErrorCode(error: error)
+		}
-	}
+	}
