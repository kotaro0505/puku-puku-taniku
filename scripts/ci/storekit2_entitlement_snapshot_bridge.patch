@@ -84,0 +89,17 @@ Signal GodotStoreKit2::request_product_price(String p_product_id) {
+
+Signal GodotStoreKit2::request_current_entitlements() {
+	[proxy getCurrentEntitlementsWithCompletionHandler:^(EntitlementSnapshot *snapshot) {
+		Dictionary result;
+		result["error"] = toGodotString(snapshot.errorCode);
+		Array productIds;
+		for (NSString *productId in snapshot.productIds) {
+			productIds.append(toGodotString(productId));
+		}
+		result["product_ids"] = productIds;
+
+		call_deferred("emit_signal", "current_entitlements_received", result);
+	}];
+
+	return Signal(this, "current_entitlements_received");
+}
