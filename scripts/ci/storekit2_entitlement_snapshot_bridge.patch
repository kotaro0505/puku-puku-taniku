diff --git a/godot-storekit2/GodotStoreKit2Swift.swift b/godot-storekit2/GodotStoreKit2Swift.swift
index 82ae928..d7a3a9e 100644
--- a/godot-storekit2/GodotStoreKit2Swift.swift
+++ b/godot-storekit2/GodotStoreKit2Swift.swift
@@ -208,0 +209,15 @@ public final class GodotStoreKit2Proxy: NSObject,
+	public func getCurrentEntitlements() async -> EntitlementSnapshot {
+		let snapshot = EntitlementSnapshot()
+		for await verificationResult in Transaction.currentEntitlements {
+			switch verificationResult {
+			case .verified(let transaction):
+				snapshot.productIds.append(transaction.productID)
+			case .unverified(_, _):
+				// Never apply a partial entitlement snapshot. GDScript retains its
+				// last verified cache and reports the restore as failed instead.
+				snapshot.errorCode = "unverified_entitlement"
+				return snapshot
+			}
+		}
+		return snapshot
+	}
@@ -254,0 +270,6 @@ public class ProductInfo: NSObject {
+
+@objcMembers
+public class EntitlementSnapshot: NSObject {
+	public var productIds: [String] = []
+	public var errorCode = ""
+}
